# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# Local development: no login, the caller is the X-Dev-User header. See docs/configuration.md.
AUTH_MODE=noauth
HTTP_PORT=9100
# The web app's origins, comma-separated. Unset in noauth mode echoes any origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
VAULT_ADDR=localhost:9091
IDENTITY_ADDR=localhost:9092
WORKFLOW_ADDR=localhost:9093
AUDIT_ADDR=localhost:9194
NOTIFY_ADDR=localhost:9195
SSHBROKER_ADDR=localhost:9096
